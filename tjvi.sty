\def\DefineOption#1#2#3{%
  % #1: package
  % #2: key
  % #3: value
  \DeclareOptionBeamer{#3}{\expandafter\def\csname tjbeamer@#1@#2\endcsname{#3}}%
}
\def\EqualOption{TT\fi\ifEqualOption}
\def\ifEqualOption#1#2#3{%
  % #1: package
  % #2: key
  % #3: value
  \edef\tempvar{\csname tjbeamer@#1@#2\endcsname}%
  \def\tempvalue{#3}%
  \ifx\tempvar\tempvalue\tjbeamer@tempiftrue\else\tjbeamer@tempiffalse\fi%
  \iftjbeamer@tempif%
}
\def\IsEmpty{TT\fi\ifIsEmpty}
\def\ifIsEmpty#1{%
  \setbox\tjbeamer@tempbox=\hbox\bgroup\def\\{}#1\unskip\egroup%
  \ifdim\wd\tjbeamer@tempbox=0pt \tjbeamer@tempiftrue%
  \else\tjbeamer@tempiffalse\fi%
  \iftjbeamer@tempif%
}
