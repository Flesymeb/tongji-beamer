\newcommand{\definelogo}[4]{
  \expandafter\providecommand\csname #1\endcsname[1][]{%
    \tikzexternaldisable%
    \begin{tikzpicture}
      \node[inner sep=0pt, ##1] {\includegraphics[height=1.5cm]{#2}};
    \end{tikzpicture}%
  }
}
